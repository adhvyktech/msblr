{
  "name": "@msblr/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --import tsx --env-file=.env src/index.ts",
    "build": "tsc --noEmit -p tsconfig.json && prisma generate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "reset": "prisma migrate reset --force",
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.9",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.11",
    "@msblr/shared": "*",
    "@prisma/client": "6.19.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.6.6",
    "@types/node-cron": "3.0.11",
    "@types/pdfkit": "0.17.7",
    "csv-parse": "7.0.3",
    "dayjs": "1.11.23",
    "exceljs": "4.4.0",
    "fast-glob": "3.3.3",
    "fastify": "5.12.8",
    "firebase-admin": "14.5.1",
    "jsonwebtoken": "9.0.3",
    "nanoid": "6.0.2",
    "node-cron": "4.6.0",
    "pdfkit": "0.20.2",
    "prisma": "6.19.3",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1",
    "zod": "3.25.76"
  }
}
