// MSBLR E-Directory — single source of truth for the data model.
// Builder agents: do NOT edit this file. Report needed changes instead.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- enums ----------
enum FamilyStatus { PENDING ACTIVE REJECTED INACTIVE }
enum SubscriptionStatus { ACTIVE DUE EXPIRED }
enum Relation { SELF SPOUSE SON DAUGHTER DAUGHTER_IN_LAW SON_IN_LAW FATHER MOTHER BROTHER SISTER GRANDSON GRANDDAUGHTER OTHER }
enum Gender { MALE FEMALE OTHER }
enum UserStatus { ACTIVE DISABLED }
enum RequestStatus { PENDING APPROVED REJECTED }
enum PaymentKind { SUBSCRIPTION AD DONATION }
enum PaymentStatus { PENDING APPROVED REJECTED }
enum FileVisibility { PUBLIC MEMBERS PRIVATE }
enum BusinessStatus { PENDING APPROVED HIDDEN REJECTED }
enum EventKind { AGM EC SOCIAL RELIGIOUS CULTURAL SPORTS OTHER }
enum PublishStatus { DRAFT PUBLISHED }
enum BannerKind { BANNER AD VIDEO }
enum AdPlatform { WEB APP BOTH }
enum AdPeriod { MONTHLY QUARTERLY HALF_YEARLY YEARLY }
enum AdRequestStatus { REQUESTED CONTENT_SUBMITTED RETURNED APPROVED LIVE PAUSED EXPIRED REJECTED }
enum ClickType { CALL WHATSAPP WEB NONE }
enum Audience { ALL ZONE LIST SINGLE }
enum WishKind { BIRTHDAY ANNIVERSARY }

// ---------- reference ----------
model Zone {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  sort      Int       @default(0)
  families  Family[]
  events    Event[]
  userRoles UserRole[]
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------- members ----------
model Family {
  id                     Int                @id @default(autoincrement())
  membershipNo           String?            @unique
  zoneId                 Int?
  zone                   Zone?              @relation(fields: [zoneId], references: [id])
  addressLine            String?
  area                   String?
  city                   String             @default("Bengaluru")
  pincode                String?
  status                 FamilyStatus       @default(PENDING)
  subscriptionStatus     SubscriptionStatus @default(DUE)
  subscriptionValidUntil DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  persons                Person[]
  registrations          Registration[]
  payments               Payment[]
  businesses             Business[]

  @@index([zoneId])
  @@index([status])
}

model Person {
  id               Int                       @id @default(autoincrement())
  familyId         Int
  family           Family                    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  isHead           Boolean                   @default(false)
  name             String
  relation         Relation                  @default(SELF)
  gender           Gender?
  dob              DateTime?
  anniversary      DateTime?
  mobile           String?
  email            String?
  education        String?
  occupation       String?
  bloodGroup       String?
  photoFileId      Int?
  photo            File?                     @relation("PersonPhoto", fields: [photoFileId], references: [id])
  wishesOptOut     Boolean                   @default(false)
  deletedAt        DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  user             User?
  privacy          PrivacySetting[]
  activationReqs   LoginActivationRequest[]
  businesses       Business[]
  wishLogs         WishLog[]

  @@index([familyId])
  @@index([mobile])
  @@index([name])
}

model PrivacySetting {
  personId Int
  person   Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  field    String  // mobile | whatsapp | email | address | photo | dob | anniversary | business
  visible  Boolean

  @@id([personId, field])
}

model User {
  id           Int          @id @default(autoincrement())
  mobile       String       @unique
  personId     Int?         @unique
  person       Person?      @relation(fields: [personId], references: [id])
  advertiserId Int?         @unique
  advertiser   Advertiser?  @relation(fields: [advertiserId], references: [id])
  displayName  String?
  status       UserStatus   @default(ACTIVE)
  language     String       @default("en")
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  roles        UserRole[]
  sessions     Session[]
  deviceTokens DeviceToken[]
  files        File[]
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique // super_admin, admin, finance, content, ad_manager, head, family_viewer, advertiser
  label       String
  isStaff     Boolean          @default(false)
  permissions RolePermission[]
  users       UserRole[]
}

model RolePermission {
  roleId Int
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  perm   String

  @@id([roleId, perm])
}

model UserRole {
  id     Int   @id @default(autoincrement())
  userId Int
  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId Int
  role   Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  zoneId Int?
  zone   Zone? @relation(fields: [zoneId], references: [id])

  @@unique([userId, roleId, zoneId])
}

model Session {
  id          String    @id @default(cuid())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String    @unique
  deviceName  String?
  platform    String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())

  @@index([userId])
}

model OtpRequest {
  id        Int      @id @default(autoincrement())
  mobile    String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  ip        String?
  createdAt DateTime @default(now())

  @@index([mobile, createdAt])
}

model LoginActivationRequest {
  id          Int           @id @default(autoincrement())
  personId    Int
  person      Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  requestedBy Int           // userId of head
  status      RequestStatus @default(PENDING)
  decidedBy   Int?
  decidedAt   DateTime?
  remarks     String?
  createdAt   DateTime      @default(now())

  @@index([status])
}

model Registration {
  id          Int           @id @default(autoincrement())
  familyId    Int
  family      Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  submittedAt DateTime      @default(now())
  status      RequestStatus @default(PENDING)
  decidedBy   Int?
  decidedAt   DateTime?
  remarks     String?
  documents   RegistrationDocument[]

  @@index([status])
}

model RegistrationDocument {
  registrationId Int
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  fileId         Int
  file           File         @relation(fields: [fileId], references: [id])
  label          String?

  @@id([registrationId, fileId])
}

// ---------- files ----------
model File {
  id            Int            @id @default(autoincrement())
  ownerUserId   Int?
  owner         User?          @relation(fields: [ownerUserId], references: [id])
  kind          String         // photo | document | payment_proof | ad_creative | banner | highlight | trust_doc | logo | receipt_pdf | business_photo
  path          String         // relative to UPLOAD_DIR
  originalName  String?
  mime          String
  size          Int
  visibility    FileVisibility @default(PRIVATE)
  createdAt     DateTime       @default(now())
  personPhotos  Person[]       @relation("PersonPhoto")
  regDocs       RegistrationDocument[]
}

// ---------- payments ----------
model Payment {
  id               Int           @id @default(autoincrement())
  kind             PaymentKind
  familyId         Int?
  family           Family?       @relation(fields: [familyId], references: [id])
  adRequestId      Int?
  adRequest        AdRequest?    @relation(fields: [adRequestId], references: [id])
  payerUserId      Int?
  amount           Decimal       @db.Decimal(10, 2)
  utr              String        @unique
  paidOn           DateTime
  purpose          String?       // e.g. "Subscription 2026-27"
  periodLabel      String?
  screenshotFileId Int?
  status           PaymentStatus @default(PENDING)
  verifiedBy       Int?
  verifiedAt       DateTime?
  remarks          String?
  createdAt        DateTime      @default(now())
  receipt          Receipt?

  @@index([status])
  @@index([familyId])
}

model Receipt {
  id         Int      @id @default(autoincrement())
  paymentId  Int?     @unique
  payment    Payment? @relation(fields: [paymentId], references: [id])
  serialNo   String   @unique
  fy         String
  familyId   Int?
  memberName String
  amount     Decimal  @db.Decimal(10, 2)
  purpose    String
  utr        String?
  issuedAt   DateTime @default(now())
  pdfFileId  Int?
  legacy     Boolean  @default(false)

  @@index([fy])
  @@index([familyId])
}

model ReceiptCounter {
  fy     String @id
  lastNo Int    @default(0)
}

// ---------- business ----------
model BusinessCategory {
  id         Int        @id @default(autoincrement())
  nameEn     String     @unique
  nameHi     String?
  sort       Int        @default(0)
  businesses Business[]
}

model Business {
  id          Int               @id @default(autoincrement())
  familyId    Int
  family      Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  personId    Int?
  person      Person?           @relation(fields: [personId], references: [id])
  name        String
  categoryId  Int?
  category    BusinessCategory? @relation(fields: [categoryId], references: [id])
  description String?
  addressLine String?
  area        String?
  phone       String?
  whatsapp    String?
  website     String?
  mapsUrl     String?
  logoFileId  Int?
  photoFileIds Int[]            @default([])
  status      BusinessStatus    @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  @@index([status])
  @@index([categoryId])
}

model StaticContact {
  id      Int     @id @default(autoincrement())
  section String  // EMERGENCY | SABHA | OTHER (free text allowed)
  name    String
  phone   String
  details String?
  sort    Int     @default(0)
}

// ---------- trusts ----------
model Trust {
  id          Int               @id @default(autoincrement())
  name        String
  description String?
  sort        Int               @default(0)
  attachments TrustAttachment[]
}

model TrustAttachment {
  id      Int    @id @default(autoincrement())
  trustId Int
  trust   Trust  @relation(fields: [trustId], references: [id], onDelete: Cascade)
  label   String
  fileId  Int?
  url     String?
}

// ---------- events ----------
model Event {
  id              Int           @id @default(autoincrement())
  title           String
  body            String?
  kind            EventKind     @default(OTHER)
  zoneId          Int?
  zone            Zone?         @relation(fields: [zoneId], references: [id])
  startsAt        DateTime
  endsAt          DateTime?
  venue           String?
  registrationUrl String?
  noticeFileId    Int?
  status          PublishStatus @default(PUBLISHED)
  createdBy       Int?
  createdAt       DateTime      @default(now())
  highlights      Highlight[]

  @@index([startsAt])
}

model Highlight {
  id          Int           @id @default(autoincrement())
  eventId     Int?
  event       Event?        @relation(fields: [eventId], references: [id])
  title       String
  summary     String?
  mediaFileIds Int[]        @default([])
  status      PublishStatus @default(PUBLISHED)
  authorId    Int?
  publishedAt DateTime      @default(now())
}

model Announcement {
  id        Int       @id @default(autoincrement())
  title     String
  body      String?
  pinned    Boolean   @default(false)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model Banner {
  id         Int        @id @default(autoincrement())
  kind       BannerKind @default(BANNER)
  title      String?
  subtitle   String?
  fileId     Int?
  linkUrl    String?
  adId       Int?
  ad         Ad?        @relation(fields: [adId], references: [id])
  sort       Int        @default(0)
  durationMs Int        @default(6000)
  activeFrom DateTime?
  activeTo   DateTime?
  active     Boolean    @default(true)
}

// ---------- advertisements ----------
model Advertiser {
  id             Int         @id @default(autoincrement())
  name           String
  contactPerson  String?
  mobile         String
  email          String?
  memberFamilyId Int?
  createdAt      DateTime    @default(now())
  user           User?
  requests       AdRequest[]
}

model AdPlacement {
  id        Int        @id @default(autoincrement())
  code      String     @unique // HOME_CAROUSEL, WEB_SIDE, WEB_INLINE, WEB_FOOTER, WEB_BIZ_SPOTLIGHT, APP_CARD, APP_BIZ_CARD, APP_LOADING
  name      String
  platform  AdPlatform
  width     Int
  height    Int
  maxKb     Int
  formats   String     // "jpg,png" or "jpg,png,mp4"
  videoMaxS Int?
  active    Boolean    @default(true)
  plans     AdPlan[]
  requests  AdRequest[]
}

model AdPlan {
  id          Int         @id @default(autoincrement())
  placementId Int
  placement   AdPlacement @relation(fields: [placementId], references: [id])
  period      AdPeriod
  price       Decimal     @db.Decimal(10, 2)
  active      Boolean     @default(true)
  requests    AdRequest[]

  @@unique([placementId, period])
}

model AdRequest {
  id           Int             @id @default(autoincrement())
  advertiserId Int
  advertiser   Advertiser      @relation(fields: [advertiserId], references: [id])
  placementId  Int
  placement    AdPlacement     @relation(fields: [placementId], references: [id])
  planId       Int?
  plan         AdPlan?         @relation(fields: [planId], references: [id])
  status       AdRequestStatus @default(REQUESTED)
  notes        String?
  remarks      String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  ads          Ad[]
  payments     Payment[]
}

model Ad {
  id             Int        @id @default(autoincrement())
  requestId      Int
  request        AdRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  creativeFileId Int?
  textLine       String?    // for loading screen text ads
  title          String?
  clickType      ClickType  @default(NONE)
  clickValue     String?    // phone / url
  priority       Int        @default(1) // 1 normal, 2 high, 3 top
  shuffle        Boolean    @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  paused         Boolean    @default(false)
  createdAt      DateTime   @default(now())
  stats          AdStatDaily[]
  views          AdView[]
  banners        Banner[]
}

model AdStatDaily {
  adId           Int
  ad             Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  date           DateTime @db.Date
  impressions    Int      @default(0)
  clicksCall     Int      @default(0)
  clicksWhatsapp Int      @default(0)
  clicksWeb      Int      @default(0)
  uniqueViewers  Int      @default(0)

  @@id([adId, date])
}

model AdView {
  adId      Int
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  viewerKey String

  @@id([adId, date, viewerKey])
}

// ---------- notifications ----------
model Notification {
  id          Int                    @id @default(autoincrement())
  title       String
  body        String
  titleHi     String?
  bodyHi      String?
  audience    Audience
  audienceRef String?                // zoneId | comma userIds | userId
  kind        String                 @default("general") // general | wish | payment | registration | ad | reminder
  sentBy      Int?
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime               @default(now())
  deliveries  NotificationDelivery[]
}

model NotificationDelivery {
  notificationId Int
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         Int
  readAt         DateTime?
  pushStatus     String       @default("queued") // queued | sent | failed | no_token

  @@id([notificationId, userId])
  @@index([userId])
}

model DeviceToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   // web | android | ios
  updatedAt DateTime @updatedAt
}

model MessageTemplate {
  id     Int    @id @default(autoincrement())
  name   String @unique
  title  String
  body   String
}

model WishLog {
  personId Int
  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  kind     WishKind
  year     Int

  @@id([personId, kind, year])
}

// ---------- audit ----------
model AuditLog {
  id          Int      @id @default(autoincrement())
  at          DateTime @default(now())
  actorUserId Int?
  actorName   String?
  actorRole   String?
  action      String   // e.g. payment.approve, person.update, auth.login
  entity      String?
  entityId    String?
  summary     String?
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?

  @@index([at])
  @@index([actorUserId])
  @@index([entity, entityId])
}
